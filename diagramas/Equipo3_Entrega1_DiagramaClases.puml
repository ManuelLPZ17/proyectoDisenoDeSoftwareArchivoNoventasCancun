@startuml Equipo3_Entrega1_DiagramaClases
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 5
skinparam shadowing false
skinparam linetype ortho

enum EstadoPropuesta {
  PENDIENTE
  REVISADA
  APROBADA
  RECHAZADA
}

class Locacion {
  - idLocacion : Integer
  - nombre : String
  - descripcion : String
  - latitud : Float
  - longitud : Float
  + actualizarDatos(nombre : String, desc : String, lat : Float, lng : Float) : Boolean
  + validarCoordenadas() : Boolean
  + obtenerArchivo() : Archivo
}

class Archivo {
  - idArchivo : Integer
  - totalDocumentos : Integer
  - pesoAcumuladoBytes : Long
  - fechaActualizacion : DateTime
  + agregarDocumento(documento : Documento) : Void
  + generarLineaTiempo() : List<Documento>
  + validarLimiteZIP() : Boolean
  + comprimirArchivoZIP() : String
}

class Documento {
  - idDocumento : Integer
  - titulo : String
  - cortesiaDe : String
  - fechaPublicacion : DateTime
  + vincularImagen(imagen : Imagen) : Void
  + validarIntegridadDocumento() : Boolean
  + agregarHipervinculo(idDestino : Integer) : Void
}

class DocumentoPDF {
  - rutaArchivoPdf : String
  - anioHistorico : Integer
  - numeroPaginas : Integer
  - pesoBytes : Long
  + obtenerEnlaceDescarga() : String
  + validarFormatoPDF() : Boolean
}

class Imagen {
  - idImagen : Integer
  - anioHistorico : Integer
  - rutaImagen : String
  - formatoImagen : String
  - pesoBytes : Long
  + obtenerEnlaceDescarga() : String
  + validarFormatoImagen() : Boolean
}

class Texto {
  - idTexto : Integer
  - contenido : String
  - tieneValorArtistico : Boolean
  - extensionPalabras : Integer
  + validarAutonomia() : Boolean
  + obtenerExtracto() : String
}

class PropuestaAporte {
  - idPropuesta : Integer
  - folioSeguimiento : String
  - estado : EstadoPropuesta
  - anioSugerido : Integer
  - rutaArchivoTemporal : String
  - motivoRechazo : String
  + marcarEnRevision() : Void
  + aprobar(curador : Administrador) : Documento
  + rechazar(motivo : String) : Boolean
}

class Administrador {
  - idAdmin : Integer
  - nombreCompleto : String
  - correoElectronico : String
  - passwordHash : String
  - ultimoAcceso : DateTime
  + autenticar(credenciales : String) : Boolean
  + cerrarSesion() : Void
  + dictaminarPropuesta(propuesta : PropuestaAporte, aprobado : Boolean, motivo : String) : Void
}

' Relaciones estructurales (Composición, Agregación y Herencia)
Locacion "1" *-- "1" Archivo : posee >
Archivo "1" o-- "0..*" Documento : agrupa >
Documento "1" *-- "1" Texto : incluye >
Documento "1" o-- "0..*" Imagen : contiene >
Documento <|-- DocumentoPDF

' Relaciones de asociación
Locacion "1" <-- "0..*" PropuestaAporte : referencia <
Administrador "1" --> "0..*" PropuestaAporte : dictamina >
Administrador "1" --> "0..*" Documento : publica >

@enduml
